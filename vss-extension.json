{
  "manifestVersion": 1,
  "id": "agent-pool-health",
  "publisher": "turanemin",
  "version": "0.8.2",
  "name": "Agent Pool Health Dashboard",
  "description": "See the status of all self-hosted agent pools, running jobs and queued jobs on one page.",
  "public": true,
  "categories": [
    "Azure Pipelines"
  ],
  "tags": [
    "agent",
    "agent pool",
    "pipelines",
    "monitoring",
    "self-hosted",
    "devops"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "scopes": [
    "vso.agentpools"
  ],
  "icons": {
    "default": "static/icon.png"
  },
  "branding": {
    "color": "#005A9E",
    "theme": "dark"
  },
  "content": {
    "details": {
      "path": "overview.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "contributions": [
    {
      "id": "agent-pool-health-hub",
      "type": "ms.vss-web.hub",
      "targets": [
        "ms.vss-build-web.build-release-hub-group"
      ],
      "properties": {
        "name": "Agent Health",
        "order": 99,
        "uri": "dist/hub/hub.html"
      }
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "static",
      "addressable": true
    }
  ]
}
